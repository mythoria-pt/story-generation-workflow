# Local development template. Set credentials before starting the service.
NODE_ENV=development
PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-me
DB_NAME=mythoria_db
WORKFLOWS_DB=workflows_db
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_CLOUD_REGION=europe-west9
STORAGE_BUCKET_NAME=your-assets-bucket
# Required for paid physical order proofs. Enforce public access prevention.
# PRINT_PROOF_BUCKET=your-private-print-proofs
STORY_GENERATION_WORKFLOW_API_KEY=replace-with-a-long-random-secret
GOOGLE_GENAI_API_KEY=replace-with-your-existing-google-api-key
TEXT_PROVIDER=google-genai
IMAGE_PROVIDER=google-genai
GOOGLE_GENAI_IMAGE_MODEL=gemini-nano-banana-2.1
TTS_PROVIDER=google-genai
TTS_MODEL=gemini-3.8-flash-tts

GOOGLE_GENAI_MODEL=gemini-4-hydrogen
TTS_DIRECTION_MODEL=gemini-4-hydrogen
GOOGLE_GENAI_API_VERSION=v1beta
STORY_TEXT_GENERATION_MODE=hybrid
STORY_SEQUENTIAL_AUDIENCES=young_adult_15-17,adult_18+
STORY_SEQUENTIAL_MIN_CHAPTERS=8
STORY_WHOLE_MAX_OUTPUT_TOKENS=262144
STORY_CHAPTER_MAX_OUTPUT_TOKENS=131072
