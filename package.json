{
  "name": "story-generation-workflow",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node node_modules/typescript-native/bin/tsc && tsc-alias && node scripts/copy-build-assets.mjs",
    "start": "node dist/index.js",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "logs": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\logs.ps1",
    "logs:tail": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\logs.ps1 -Follow",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx -r dotenv/config ./src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "workflows-db:generate": "drizzle-kit generate --config=drizzle.workflows.config.ts",
    "workflows-db:migrate": "tsx -r dotenv/config ./src/db/migrate-workflows.ts",
    "workflows-db:push": "drizzle-kit push --config=drizzle.workflows.config.ts",
    "workflows-db:studio": "drizzle-kit studio --config=drizzle.workflows.config.ts",
    "sync-schema": "powershell -ExecutionPolicy Bypass -File .\\scripts\\sync-schema.ps1",
    "docker:build": "docker build -t story-generation-workflow .",
    "docker:run": "docker run -p 8080:8080 story-generation-workflow",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\deploy.ps1",
    "deploy:fast": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\deploy.ps1 -Fast",
    "setup-secrets": "powershell -ExecutionPolicy Bypass -File .\\scripts\\setup-secrets.ps1",
    "check-secrets": "powershell -ExecutionPolicy Bypass -File .\\scripts\\check-secrets.ps1",
    "env:validate": "tsx src/config/validate-env.ts",
    "env:parity": "tsx scripts/check-env-parity.ts",
    "get-logs": "gcloud logging read \"resource.type=cloud_run_revision AND resource.labels.service_name=story-generation-workflow\" --limit=30 --format=\"json\" --project=oceanic-beach-460916-n5",
    "schema:sync": "powershell -ExecutionPolicy Bypass -File .\\scripts\\sync-schema.ps1",
    "schema:sync-dry": "powershell -ExecutionPolicy Bypass -File .\\scripts\\sync-schema.ps1 -DryRun",
    "schema:sync-verbose": "powershell -ExecutionPolicy Bypass -File .\\scripts\\sync-schema.ps1 -Verbose",
    "clean": "rimraf dist",
    "lint:bash": "bash ./scripts/lint.sh",
    "i18n:keys": "tsx scripts/check-i18n.ts keys de-DE",
    "i18n:parity": "tsx scripts/check-i18n.ts parity de-DE",
    "dev:biographer-live": "tsx watch src/biographer-live.ts",
    "start:biographer-live": "node dist/biographer-live.js"
  },
  "dependencies": {
    "@google-cloud/storage": "^9.0.0",
    "@google-cloud/workflows": "^6.2.0",
    "@google/genai": "^3.6.1",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "hyphen": "^1.14.1",
    "node-domexception": "file:compat/node-domexception",
    "node-html-parser": "^9.0.7",
    "openai": "^7.63.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "puppeteer": "^25.18.1",
    "sharp": "^0.35.5",
    "tmp": "^0.2.7",
    "winston": "^3.19.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/hyphen": "^1.14.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@types/tmp": "^0.2.6",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-native": "npm:typescript@^7.0.2",
    "yaml": "^2.9.1"
  },
  "optionalDependencies": {
    "@img/sharp-linux-arm64": "0.35.5",
    "@img/sharp-linux-x64": "0.35.5"
  },
  "overrides": {
    "openai": {
      "google-auth-library": "$google-auth-library"
    },
    "@jest/reporters": {
      "glob": "14.0.6"
    },
    "jest-config": {
      "glob": "14.0.6"
    },
    "jest-runtime": {
      "glob": "14.0.6"
    },
    "test-exclude": {
      "glob": "14.0.6",
      "minimatch": "11.0.9"
    },
    "node-domexception": "$node-domexception",
    "drizzle-kit": {
      "@esbuild-kit/esm-loader": "npm:tsx@4.23.15"
    }
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": false,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": false,
    "protobufjs@7.6.6": false,
    "puppeteer@25.18.1": true
  },
  "engines": {
    "node": "24.18.1"
  }
}
